#: src/preferences/pages/blacklist.ui:6 src/preferences/pages/blacklist.ui:10
msgid "Blacklist / Whitelist"
msgstr "黑名单 / 白名单"

#: src/preferences/pages/blacklist.ui:11
msgid ""
"Not all application can works well with rounded corners effects, add them to "
"this list to disable effects."
msgstr "部分应用可能与圆角效果不兼容，可将其添加到此列表以禁用圆角。"

#: src/preferences/pages/blacklist.ui:14
msgid "Use as Whitelist"
msgstr "用作白名单"

#: src/preferences/pages/blacklist.ui:15
msgid ""
"When selected, instead of omitting certain windows, only allows certain "
"windows."
msgstr "启用后，仅为列表中的窗口应用圆角效果。"

#: src/preferences/pages/blacklist.ui:25 src/preferences/pages/custom.ui:19
msgid "Add window"
msgstr "添加窗口"

#: src/preferences/pages/custom.ui:6 src/preferences/pages/custom.ui:10
msgid "Custom"
msgstr "自定义"

#: src/preferences/pages/custom.ui:11
msgid "Set custom effect setting for each window class"
msgstr "为各个窗口类设置自定义圆角效果"

#: src/preferences/pages/edit-shadow.ui:6
msgid "Edit shadows"
msgstr "编辑阴影"

#: src/preferences/pages/edit-shadow.ui:28
msgid "Focused window"
msgstr "已获取焦点的窗口"

#: src/preferences/pages/edit-shadow.ui:43
msgid "Unfocused window"
msgstr "未获取焦点的窗口"

#: src/preferences/pages/edit-shadow.ui:66
msgid "Focused shadow preferences"
msgstr "聚焦窗口的阴影设置"

#: src/preferences/pages/edit-shadow.ui:69
#: src/preferences/pages/edit-shadow.ui:209
msgid "Horizontal offset"
msgstr "水平偏移"

#: src/preferences/pages/edit-shadow.ui:96
#: src/preferences/pages/edit-shadow.ui:236
msgid "Vertical offset"
msgstr "垂直偏移"

#: src/preferences/pages/edit-shadow.ui:123
#: src/preferences/pages/edit-shadow.ui:263
msgid "Blur radius"
msgstr "模糊半径"

#: src/preferences/pages/edit-shadow.ui:150
#: src/preferences/pages/edit-shadow.ui:290
msgid "Spread radius"
msgstr "扩散半径"

#: src/preferences/pages/edit-shadow.ui:177
#: src/preferences/pages/edit-shadow.ui:317
msgid "Opacity"
msgstr "不透明度"

#: src/preferences/pages/edit-shadow.ui:206
msgid "Unfocused shadow preferences"
msgstr "未聚焦窗口的阴影设置"

#: src/preferences/pages/general.ui:6
msgid "General"
msgstr "通用"

#: src/preferences/pages/general.ui:10
msgid "Applications"
msgstr "应用设置"

#: src/preferences/pages/general.ui:11
msgid ""
"Some applications created with LibAdwaita or LibHandy already have rounded "
"corners. You can enable those settings to avoid rounding their corners an "
"extra time."
msgstr ""
"部分使用 LibAdwaita 或 LibHandy 的应用自带圆角。启用以下设置可跳过这些应用，"
"避免重复应用圆角效果。"

#: src/preferences/pages/general.ui:14
msgid "Skip LibAdwaita applications"
msgstr "跳过 LibAdwaita 应用"

#: src/preferences/pages/general.ui:19
msgid "Skip LibHandy applications"
msgstr "跳过 LibHandy 应用"

#: src/preferences/pages/general.ui:26
msgid "Global settings"
msgstr "全局设置"

#: src/preferences/pages/general.ui:27
msgid "These settings will have an effect on all windows"
msgstr "这里的设置将影响所有窗口"

#: src/preferences/pages/general.ui:30
#: src/preferences/widgets/custom_settings_row.ts:20
msgid "Corner radius"
msgstr "圆角半径"

#: src/preferences/pages/general.ui:57
msgid "Window shadow"
msgstr "窗口阴影"

#: src/preferences/pages/general.ui:58
msgid "Customize the shadow of the rounded corner window"
msgstr "设置圆角窗口的阴影"

#: src/preferences/pages/general.ui:70
msgid "Keep shadows for maximized and fullscreen windows"
msgstr "最大化和全屏时保留阴影"

#: src/preferences/pages/general.ui:75
msgid "Keep rounded corners for maximized windows"
msgstr "最大化时保留圆角"

#: src/preferences/pages/general.ui:80
msgid "Keep rounded corners for fullscreen windows"
msgstr "窗口全屏时保留圆角"

#: src/preferences/pages/general.ui:90
msgid "Debug"
msgstr "调试"

#: src/preferences/pages/general.ui:93
msgid "Enable debug logs"
msgstr "启用日志"

#: src/preferences/pages/general.ui:94
msgid ""
"Run journalctl -o cat -f /usr/bin/gnome-shell in your terminal to see the log"
msgstr "在终端中运行 journalctl -o cat -f /usr/bin/gnome-shell 查看日志"

